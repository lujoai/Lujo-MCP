# ==============================================================================
# Lujo-MCP 生产环境配置模板
# 复制为 .env.production 并填入真实生产密码与密钥
# ==============================================================================

# --- 安全与认证 ---
API_KEY=your_production_secure_api_key_minimum_32_characters
POSTGRES_PASSWORD=your_secure_postgres_password
PG_PASSWORD=your_secure_postgres_password

# --- 数据库配置 ---
PG_DATABASE=lujo_mcp
PG_USER=postgres
PG_MAX_CONNECTIONS=20

# --- LLM 大模型提供商 ---
OPENAI_API_KEY=sk-your-openai-or-deepseek-api-key
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3

# --- 端口映射 ---
LUJO_HTTP_PORT=8000
PROMETHEUS_PORT=9090

# --- 高级特性 ---
SOURCEMAP_ENABLED=true
