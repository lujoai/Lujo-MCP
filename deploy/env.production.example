# ==============================================================================
# Lujo-MCP 生产环境配置模板
# 复制为 .env.production 并填入真实生产密码与密钥
# ==============================================================================

# --- 安全与认证 ---
API_KEY=your_production_secure_api_key_minimum_32_characters

# --- 监听地址 ---
# W10 / P2-SEC-1：源码默认已收紧为 127.0.0.1（单用户本地定位）。
# 容器内必须绑 0.0.0.0，否则端口发布与容器间抓取全部打不通（compose 已显式
# 设置本值）；对外暴露面由 ports 的 127.0.0.1 发布地址 + API_KEY 控制。
# 绑非回环地址时 /metrics 不再免鉴权（P2-SEC-2），Prometheus 必须带 API Key。
HOST=0.0.0.0

# --- LLM 大模型提供商 ---
OPENAI_API_KEY=sk-your-openai-or-deepseek-api-key
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=30
# M2-CONFIGSYNC：对齐 config.py 权威默认 0.3（原 0.2 为无依据历史漂移）
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=3

# --- 端口映射 ---
LUJO_HTTP_PORT=8000
PROMETHEUS_PORT=9090

# --- 高级特性 ---
SOURCEMAP_ENABLED=true
