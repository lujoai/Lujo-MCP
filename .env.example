# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，切勿提交）

# ── LLM ──
# LLM_PROVIDER: openai | zhipu | deepseek | custom
#   zhipu    → base_url 自动 = https://open.bigmodel.cn/api/paas/v4/（glm-4.7-flash 免费）
#   deepseek → base_url 自动 = https://api.deepseek.com（模型推荐 deepseek-v4-flash，密钥同样填 OPENAI_API_KEY）
#   custom   → 需填 LLM_BASE_URL（任意 OpenAI 兼容端点）
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=3

# ── 上下文截断 ──
STORAGE_BACKEND=memory
MAX_CONTEXT_TOKENS=8000
MAX_STACK_FRAMES=20

# ── 调试提示词（FR12）──
# GET /api/debug/prompt 的模板文件路径；支持 $context / $request_id 占位符。
# 为空或文件不存在时回退内置默认模板。
PROMPT_TEMPLATE_PATH=

# --- Phase 1: 存储容量 ---
MEMORY_STORE_MAX_ENTRIES=10000

# ── PostgreSQL（STORAGE_BACKEND=postgresql 时生效）──
# 应用本身只读取 PG_HOST / PG_PORT / PG_DATABASE / PG_USER / PG_PASSWORD。
# POSTGRES_PASSWORD 仅供 docker-compose 初始化 PostgreSQL 服务时使用；
# 若同时存在，建议保持与 PG_PASSWORD 一致，避免本地环境漂移。
# DATABASE_URL 仅供外部工具或脚本兼容，应用本身不会读取；
# 若密码包含 @、:、/ 等特殊字符，必须先做 URL 编码（例如 @ -> %40）。
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=lujo_mcp
PG_USER=postgres
PG_PASSWORD=
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Phase 3: 异步存储 ---
PG_ASYNC_ENABLED=false
PG_ASYNC_MIN=2
PG_ASYNC_MAX=20

# --- Phase 5: 分区 / 归档 ---
PG_PARTITION_ENABLED=false
PG_PARTITION_PRECREATE_MONTHS=2
PG_ARCHIVE_ENABLED=false
PG_ARCHIVE_DAYS=30
PG_ARCHIVE_DELETE_AFTER=true

# ── 状态后端（限流/指标，多实例部署设为 redis）──
STATE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ── 清理 TTL ──
TRACE_TTL_SECONDS=3600
SESSION_TTL_SECONDS=3600

# ── 安全 ──
# 设置后所有 /mcp 与 /api 请求需携带 Bearer Token 或 X-API-Key
API_KEY=

# --- Phase 1: CORS ---
CORS_ORIGINS=

# --- Phase 2: 监控鉴权 ---
METRICS_AUTH_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
MAX_BODY_SIZE=1048576
# 诊断端点开关（echo/token），生产环境保持 False
DEBUG_ENDPOINTS_ENABLED=false

# ── 日志 / 服务 ──
LOG_LEVEL=INFO
LOG_FORMAT=text
DEBUG=false

# ── 脱敏 ──
# 默认开启：数据入库前统一掩码敏感字段（fail-safe）
REDACTION_ENABLED=true
# 脱敏白名单字段名（逗号分隔），命中白名单的键名即使含敏感子串也不脱敏
# 内置默认白名单已含 password_hash/public_key/key_count 等常见安全字段

# --- Phase 2: 脱敏白名单 ---
REDACTION_KEY_ALLOWLIST=

# ── OpenTelemetry（P3-4）──
# 是否启用 OTel 指标导出（默认关闭）
# 开启后使用 OTel SDK 记录指标，同时保留 /metrics Prometheus 文本端点向后兼容
OTEL_ENABLED=false
# OTel 服务名（用于指标标签）
OTEL_SERVICE_NAME=lujo-mcp
# OTLP gRPC 导出端点（如 http://localhost:4317），为空则使用 OTEL_EXPORTER_OTLP_ENDPOINT 环境变量
OTEL_EXPORTER_ENDPOINT=
# OTel 指标导出间隔（毫秒）
OTEL_METRICS_INTERVAL_MS=60000

# ── Playwright / UI Verify 安全控制 ──
# 默认拒绝私网、回环、云元数据地址；本地联调需显式放开
UI_URL_ALLOW_PRIVATE=false
# 额外允许的主机白名单，逗号分隔（如 localhost,127.0.0.1,test.internal）
UI_URL_ALLOWLIST=

# ── MCP 工具超时 ──
# auto_test / verify_ui 耗时较长时可适当调大
TOOL_TIMEOUT_SECONDS=60

# ── 熔断器（P3-8）──
CIRCUIT_BREAKER_ENABLED=false
CB_LLM_MAX_FAILURES=5
CB_LLM_RESET_TIMEOUT=30
CB_PG_MAX_FAILURES=3
CB_PG_RESET_TIMEOUT=15

# ── 向量检索 RAG（Phase 7）──
# 全局开关：开启后 LLM 分析前先做向量召回（精确指纹 miss 后的二级 fallback）
VECTOR_STORE_ENABLED=false
# 后端：in_process（默认，零依赖 Jaccard 相似度）| qdrant（OpenAI Embeddings 语义召回）
VECTOR_STORE_BACKEND=in_process
VECTOR_STORE_TOP_K=3
VECTOR_STORE_MIN_SCORE=0.3
# Qdrant 配置（仅 backend=qdrant 时生效；连接失败静默降级，不阻塞 LLM 主链路）
QDRANT_URL=
QDRANT_COLLECTION=ai-debug-kb
QDRANT_API_KEY=
# Embedding 模型：OpenAI 用 text-embedding-3-small（1536维）；智谱用 embedding-3（1024维）
QDRANT_EMBEDDING_MODEL=text-embedding-3-small
# 向量维度：必须与模型对齐，且与已建 collection 维度一致；不匹配时降级不自动重建
QDRANT_EMBEDDING_DIM=1536
QDRANT_REQUEST_TIMEOUT=10
