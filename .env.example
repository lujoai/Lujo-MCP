# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，切勿提交）

# ── LLM ──
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# ── 上下文截断 ──
STORAGE_BACKEND=memory
MAX_CONTEXT_TOKENS=8000
MAX_STACK_FRAMES=20

# ── PostgreSQL（STORAGE_BACKEND=postgresql 时生效）──
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ai_debug_mcp
PG_USER=postgres
PG_PASSWORD=

# ── 状态后端（限流/指标，多实例部署设为 redis）──
STATE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ── 清理 TTL ──
TRACE_TTL_SECONDS=3600
SESSION_TTL_SECONDS=3600

# ── 安全 ──
# 设置后所有 /mcp 与 /api 请求需携带 Bearer Token 或 X-API-Key
API_KEY=
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60
MAX_BODY_SIZE=1048576

# ── 日志 / 服务 ──
LOG_LEVEL=INFO
LOG_FORMAT=text
DEBUG=false
