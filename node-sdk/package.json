{
  "name": "@lujoai/lujo-mcp-node-sdk",
  "version": "0.7.9",
  "description": "Node.js SDK for reporting errors and network failures to lujo-mcp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lujoai/Lujo-MCP.git",
    "directory": "node-sdk"
  },
  "homepage": "https://github.com/lujoai/Lujo-MCP/tree/main/node-sdk",
  "bugs": {
    "url": "https://github.com/lujoai/Lujo-MCP/issues"
  },
  "keywords": [
    "debugging",
    "mcp",
    "nodejs",
    "observability",
    "error-reporting"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "main": "./index.cjs",
  "exports": {
    ".": {
      "require": "./index.cjs",
      "import": "./index.mjs",
      "default": "./index.mjs"
    }
  },
  "files": [
    "LICENSE",
    "client.cjs",
    "index.cjs",
    "index.mjs",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/node-sdk.test.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
