{
  "mcpServers": {
    "lujo": {
      "command": "npx",
      "args": ["-y", "@lujoai/lujo-mcp@0.9.4"]
    },
    "lujo-from-source": {
      "command": "python",
      "args": ["-m", "app.mcp_server", "--http"],
      "cwd": "/替换为你的项目绝对路径/lujo-mcp",
      "env": {
        "PYTHONPATH": "."
      }
    }
  }
}
